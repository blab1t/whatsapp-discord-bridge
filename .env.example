# Discord bot credentials — https://discord.com/developers/applications
DISCORD_TOKEN=your-bot-token
DISCORD_CLIENT_ID=your-application-id
DISCORD_GUILD_ID=your-private-server-id

# Timezone used to interpret /schedule times, e.g. Europe/Berlin or America/New_York
TZ=UTC

# Anyone joining who is not the bot, the server owner, or listed here is banned
AUTO_BAN=true
ALLOWED_USER_IDS=

# Set your Discord server nickname to your WhatsApp name
MIRROR_PROFILE=true

# Pull chat history on link — the only source of your contact NAMES
SYNC_HISTORY=true

# Move channels idle this many days into an Archive category
ARCHIVE_AFTER_DAYS=30

# Discord upload limit for your server tier, in MB (10 unboosted, 50 at tier 2)
MAX_UPLOAD_MB=10

# How long WhatsApp<->Discord message id pairs are kept (edits/replies/reactions)
MESSAGE_RETENTION_DAYS=90

# Your WhatsApp number, international, digits only. When set, linking uses an
# 8-character pairing code you type on your phone instead of scanning a QR.
PAIR_NUMBER=

LOG_LEVEL=info
